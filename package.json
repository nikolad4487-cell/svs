    "db:reset": "supabase db reset --local",
    "db:seed-users": "node scripts/seed-local.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "db:test:start": "node scripts/local-stack.mjs",
    "db:test:stop": "node scripts/local-stack.mjs --stop",
    "db:test:migrate": "node scripts/migrate-local.mjs",
    "db:seed-academic": "node scripts/seed-academic.mjs",
    "test:academic": "node scripts/test-academic.mjs",
    "db:bundle": "node scripts/build-setup.mjs",
    "test:migrations": "node scripts/check-migrations.mjs",
    "import:ematica": "node scripts/import-ematica.mjs",
    "test:ematica": "node scripts/test-import-ematica.mjs",
    "test:student-services": "node scripts/test-student-services.mjs",
    "test:student-cohort": "node scripts/test-student-cohort.mjs",
    "test:exam-workflow": "node scripts/test-exam-workflow.mjs",
    "test:enrollment-completion": "node scripts/test-enrollment-completion.mjs",
    "test:registrar": "node scripts/test-registrar.mjs",
    "test:domain-routes": "node scripts/test-domain-routes.mjs",
    "test:learning": "node scripts/test-learning.mjs",
    "test:learning-files": "node scripts/test-learning-files.mjs",
    "test:learning-quizzes": "node scripts/test-learning-quizzes.mjs",
    "test:learning-sections": "node scripts/test-learning-sections.mjs",
    "test:issp": "node scripts/test-issp.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  }

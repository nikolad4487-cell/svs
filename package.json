{
  "name": "svs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",

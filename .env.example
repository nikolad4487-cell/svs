BASE_DOMAIN=isvu.me
# Optional additional local base hostname, e.g. svs.test (configure hosts/DNS yourself)
LOCAL_BASE_DOMAIN=

# Supabase Project Settings > API. These two values are public, not service-role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true ONLY after enabling the Before User Created hook from the migration.
AUTH_INVITE_SIGNUP_ENABLED=false

# Optional external login pages. These links do not provision mailboxes or enable SSO.
WEBMAIL_LOGIN_URL=
MERLIN_LMS_URL=https://merlinhr.gnomio.com/my/
